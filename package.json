{
  "name": "shogi-kifu-viewer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest --watchAll=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "ajv": "^8.18.0",
    "expo": "~54.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "json-kifu-format": "^5.5.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-security": "^4.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.ts"
        ],
        "testEnvironment": "node",
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transform": {
          "^.+\\.tsx?$": [
            "babel-jest",
            {
              "configFile": false,
              "presets": [
                [
                  "babel-preset-expo",
                  {
                    "jsxImportSource": "react"
                  }
                ]
              ]
            }
          ]
        }
      },
      {
        "displayName": "components",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.tsx"
        ],
        "testEnvironment": "node",
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transform": {
          "^.+\\.tsx?$": [
            "babel-jest",
            {
              "configFile": false,
              "presets": [
                [
                  "babel-preset-expo",
                  {
                    "jsxImportSource": "react"
                  }
                ]
              ]
            }
          ]
        }
      }
    ]
  },
  "private": true
}
